{
  "name": "@aetherisnova/ui-kit",
  "version": "1.0.0",
  "private": false,
  "description": "React UI components used in the Aetheris Nova apps.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aetheris-nova/instrumentum"
  },
  "license": "CC0-1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build",
    "build:dependencies": "./scripts/prebuild.bash",
    "clean": "shx rm -rf dist && shx rm -rf tsconfig.*.tsbuildinfo",
    "lint": "eslint .",
    "prettier": "prettier --write \"**/*.{js,json,jsx,ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@aetherisnova/utilities": "workspace:^",
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@evefrontier/dapp-kit": "^0.1.9",
    "@fontsource/anonymous-pro": "^5.3.0",
    "@fontsource/cutive-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@mysten/sui": "^3.0.1",
    "@tanstack/react-query": "^5.96.2",
    "bignumber.js": "^9.1.2",
    "next-themes": "^0.4.6",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/addon-themes": "^10",
    "@storybook/react-vite": "^10",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chalk": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shx": "catalog:",
    "storybook": "^10",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
